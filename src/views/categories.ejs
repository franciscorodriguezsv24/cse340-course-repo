<%- include('partials/header') %>
<main id="main-content" class="page">
    <h1 class="page__title"><%= title %></h1>
    <p class="page__intro">Browse service opportunities by category:</p>
    <ul class="pill-list">
        <% categories.forEach(category => { %>
            <li>
                <a class="pill-list__item" href="/category/<%= category.category_id %>"><%= category.name %></a>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
