<%- include('partials/header') %>
<main id="main-content" class="page">
    <article class="detail">
        <header class="detail__header">
            <img class="detail__logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
            <div>
                <h1 class="page__title"><%= organization.name %></h1>
                <a class="detail__email" href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
                <p class="detail__edit"><a href="/edit-organization/<%= organization.organization_id %>">Edit organization</a></p>
            </div>
        </header>
        <p class="detail__description"><%= organization.description %></p>
    </article>

    <section>
        <h2 class="page__subtitle">Service Projects</h2>
        <% if (projects.length === 0) { %>
            <p class="page__intro">No service projects are listed for this organization yet.</p>
        <% } else { %>
            <ul class="card-list">
                <% projects.forEach(project => { %>
                    <% const projectDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
                    <li class="card-list__item">
                        <a class="card-list__title-link" href="/project/<%= project.project_id %>">
                            <span class="card-list__title"><%= project.title %></span>
                        </a>
                        <span class="card-list__meta"><%= projectDate %> &middot; <%= project.location %></span>
                        <span class="card-list__text"><%= project.description %></span>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>
