<%- include('partials/header') %>
<main id="main-content" class="page">
    <h1 class="page__title">Register</h1>
    <p class="page__intro">Create an account to join the CSE 340 Service Network.</p>

    <% if (errors && errors.length > 0) { %>
        <div class="form-errors" role="alert" aria-live="polite">
            <p class="form-errors__title">Please fix the following:</p>
            <ul class="form-errors__list">
                <% errors.forEach(error => { %>
                    <li><%= error.msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form class="form" action="/register" method="POST" novalidate>
        <div class="form__field">
            <label class="form__label" for="name">Name</label>
            <input
                class="form__input"
                type="text"
                id="name"
                name="name"
                value="<%= account.name %>"
                required
                maxlength="100"
                autocomplete="name"
            >
        </div>

        <div class="form__field">
            <label class="form__label" for="email">Email</label>
            <input
                class="form__input"
                type="email"
                id="email"
                name="email"
                value="<%= account.email %>"
                required
                maxlength="255"
                autocomplete="email"
            >
        </div>

        <div class="form__field">
            <label class="form__label" for="password">Password</label>
            <input
                class="form__input"
                type="password"
                id="password"
                name="password"
                required
                minlength="6"
                autocomplete="new-password"
            >
        </div>

        <div class="form__actions">
            <button class="button button--primary" type="submit">Create Account</button>
            <a class="button button--secondary" href="/login">Cancel</a>
        </div>
    </form>

    <p class="page__intro">Already have an account? <a href="/login">Log in here</a>.</p>
</main>
<%- include('partials/footer') %>
