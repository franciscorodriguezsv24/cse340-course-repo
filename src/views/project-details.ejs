<%- include('partials/header') %>
<% const projectDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
<main id="main-content" class="page">
    <article class="detail">
        <h1 class="page__title"><%= project.title %></h1>
        <p class="detail__meta">
            Hosted by
            <a class="detail__org-link" href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
        <dl class="detail__facts">
            <div class="detail__fact">
                <dt>Date</dt>
                <dd><%= projectDate %></dd>
            </div>
            <div class="detail__fact">
                <dt>Location</dt>
                <dd><%= project.location %></dd>
            </div>
        </dl>
        <p class="detail__description"><%= project.description %></p>

        <% if (loggedin) { %>
            <div class="detail__volunteer">
                <% if (isVolunteering) { %>
                    <p class="detail__volunteer-status">You are volunteering for this project.</p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="post">
                        <button type="submit" class="button button--secondary">Remove me as a volunteer</button>
                    </form>
                <% } else { %>
                    <form action="/project/<%= project.project_id %>/volunteer" method="post">
                        <button type="submit" class="button">Volunteer for this project</button>
                    </form>
                <% } %>
            </div>
        <% } %>

        <p class="page__actions">
            <a class="button button--secondary" href="/edit-project/<%= project.project_id %>">Edit project</a>
            <a class="button button--secondary" href="/assign-categories/<%= project.project_id %>">Assign categories</a>
        </p>

        <h2 class="page__subtitle">Categories</h2>
        <% if (categories && categories.length > 0) { %>
            <ul class="tag-list">
                <% categories.forEach(category => { %>
                    <li>
                        <a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No categories assigned yet.</p>
        <% } %>
    </article>
</main>
<%- include('partials/footer') %>
