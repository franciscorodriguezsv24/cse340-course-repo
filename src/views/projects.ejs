<%- include('partials/header') %>
<main id="main-content" class="page">
    <h1 class="page__title"><%= title %></h1>
    <h2 class="page__subtitle">Upcoming Service Projects</h2>
    <ul class="card-list">
        <% projects.forEach(project => { %>
            <% const projectDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
            <li class="card-list__item">
                <span class="card-list__title"><%= projectDate %>: <%= project.title %> (<em><%= project.organization_name %></em>)</span>
                <span class="card-list__text"><%= project.description %></span>
                <span class="card-list__meta"><%= project.location %></span>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
