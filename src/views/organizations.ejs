<%- include('partials/header') %>
<main id="main-content" class="page">
    <h1 class="page__title"><%= title %></h1>
    <p class="page__intro">Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach(organization => { %>
            <li class="org-list__item">
                <img class="org-list__logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <div class="org-list__body">
                    <strong class="org-list__name"><%= organization.name %></strong>
                    <a class="org-list__email" href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
                </div>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
