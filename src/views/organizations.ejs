    <ul class="org-list">
        <li class="org-list__item">
            <img class="org-list__logo" src="/images/brightfuture-logo.png" alt="">
            <div class="org-list__body">
                <strong class="org-list__name">BrightFuture Builders</strong>
                <a class="org-list__email" href="mailto:info@brightfuture.org">info@brightfuture.org</a>
            </div>
        </li>
        <li class="org-list__item">
            <img class="org-list__logo" src="/images/greenharvest-logo.png" alt="">
            <div class="org-list__body">
                <strong class="org-list__name">GreenHarvest Growers</strong>
                <a class="org-list__email" href="mailto:contact@greenharvest.org">contact@greenharvest.org</a>
            </div>
        </li>
        <li class="org-list__item">
            <img class="org-list__logo" src="/images/unityserve-logo.png" alt="">
            <div class="org-list__body">
                <strong class="org-list__name">UnityServe Volunteers</strong>
                <a class="org-list__email" href="mailto:hello@unityserve.org">hello@unityserve.org</a>
            </div>
        </li>
    </ul>
</main>
<%- include('partials/footer') %>
