<%- include('partials/header') %>
<main id="main-content" class="page">
    <h1 class="page__title">Dashboard</h1>
    <p class="page__intro">Welcome, <%= account.name %>. You are logged in as <strong><%= account.role %></strong>.</p>

    <ul class="pill-list">
        <% if (account.role === 'admin') { %>
            <li class="pill-list__row">
                <a class="pill-list__item" href="/users">Manage Registered Users</a>
            </li>
        <% } %>
    </ul>

    <h2 class="page__subtitle">My Volunteer Projects</h2>
    <% if (volunteerProjects && volunteerProjects.length > 0) { %>
        <ul class="pill-list">
            <% volunteerProjects.forEach(project => { %>
                <% const projectDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
                <li class="pill-list__row">
                    <a class="pill-list__item" href="/project/<%= project.project_id %>">
                        <%= project.title %> &mdash; <%= projectDate %>
                    </a>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="post">
                        <input type="hidden" name="redirect" value="dashboard">
                        <button type="submit" class="button button--secondary">Remove</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You have not volunteered for any projects yet. Browse the <a href="/projects">service projects</a> to get involved.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
